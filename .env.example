# ---------------------------------------------------------------------------
# TMDB (The Movie Database) credentials
#
# 1. Create a free account at https://www.themoviedb.org/signup
# 2. Go to Settings -> API -> request an API key (choose "Developer")
# 3. Copy the "API Read Access Token" (a long JWT starting with "eyJ...")
#
# Only ONE of the two below is required. The read access token is preferred.
# ---------------------------------------------------------------------------
TMDB_ACCESS_TOKEN=
# Legacy v3 key. Used only when TMDB_ACCESS_TOKEN is empty.
TMDB_API_KEY=

# Optional: region used for release dates and watch providers (ISO 3166-1).
NEXT_PUBLIC_TMDB_REGION=US
